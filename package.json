{
  "name": "audit-ai-demo",
  "version": "1.0.0",
  "description": "Deloitte Internal Audit — AI Demo Series (AuditIA)",
  "private": true,
  "type": "module",
  "scripts": {
    "install:all": "npm install && cd client && npm install",
    "dev:server": "node --max-old-space-size=4096 server.js",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently -k -n SERVER,CLIENT -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "start": "npm run dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@vercel/node": "^5.10.1",
    "concurrently": "^9.1.0"
  }
}
