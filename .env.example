# ── Requerido ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Opcional ─────────────────────────────────────────────────────────
# Modelo. claude-opus-4-7 para máxima calidad el día del demo.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Puerto del backend local (server.js). No aplica en Vercel.
PORT=3001

# Clave compartida de acceso. Si está definida, las funciones de Vercel
# exigen el header x-demo-password. Déjala vacía en local.
DEMO_PASSWORD=
